[32m+[m[32m    New-NetFirewallRule -DisplayName "Nexus LAN TEST 8001" -Direction Inbound -Protocol TCP -LocalPort 8001 `[m
[32m+[m[32m      -Action Allow -Profile Private -RemoteAddress LocalSubnet[m
