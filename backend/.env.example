# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins allowed for CSRF (Vite dev server)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both to True when served over HTTPS
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Idle session lifetime in seconds (sliding), default 8 hours
DJANGO_SESSION_COOKIE_AGE=28800
# Production behind a TLS-terminating reverse proxy (see docs/DEPLOYMENT.md): True only if the proxy sets X-Forwarded-Proto itself
DJANGO_BEHIND_PROXY=False
# Exact browser origins allowed to call /api/portal/ and /api/device/ (empty = no CORS)
DJANGO_CORS_ALLOWED_ORIGINS=
# Seconds to wait for SQL Server before the API answers 503 instead of hanging
DB_CONNECT_TIMEOUT=15

# ---- SQL Server ----
DB_NAME=SaiInfosysNexus
# Host or host\INSTANCE (named instance). Leave DB_PORT blank for named instances.
DB_HOST=.\SQLEXPRESS
DB_PORT=
# Windows authentication: set DB_TRUSTED_CONNECTION=True and leave DB_USER/DB_PASSWORD blank.
# SQL authentication: set DB_TRUSTED_CONNECTION=False and provide DB_USER/DB_PASSWORD.
DB_TRUSTED_CONNECTION=True
DB_USER=
DB_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=True
# Use True only for local/dev servers with self-signed certificates.
DB_TRUST_SERVER_CERTIFICATE=True

# ---- Project databases read by the Super Admin dashboard (same SQL Server instance, read-only) ----
GSTR_DB_NAME=Gstr_db
PRN_DB_NAME=PRNPRINT

# ---- Bootstrap accounts (development only; used by `manage.py seed_initial_users`) ----
SUPERADMIN_INITIAL_PASSWORD=Superadmin
ADMIN_INITIAL_PASSWORD=Admin

# ---- Email (SMTP). In DEBUG emails print to the console unless EMAIL_BACKEND is set. ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Port 465 instead of STARTTLS: EMAIL_USE_SSL=True
EMAIL_USE_SSL=False
# Credential emails are retried this many times (2 s, 4 s back-off) and every attempt is logged in registrations_emaillog
MAIL_SEND_ATTEMPTS=3
# The emailed temporary password must be replaced at first sign-in (1 = required)
ENFORCE_FIRST_LOGIN_PASSWORD_CHANGE=0
DEFAULT_FROM_EMAIL=Sai Infosys Nexus <no-reply@your-domain>

# ---- Customer portal ----
CUSTOMER_TOKEN_MAX_AGE=86400
PASSWORD_RESET_MAX_AGE=3600
LICENSE_LEASE_DAYS=7
# Comma separated extra addresses told about each new sign-up request (Super Admin accounts with an email are always told)
NEW_REQUEST_NOTIFY_EMAILS=

# ---- Signed device licensing (Ed25519). Generate with: python manage.py generate_license_keypair ----
# The PRIVATE key stays on this server only. Give Barcode Auto Print the PUBLIC key + key id (see `show_license_public_key`).
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_KEY_ID=k1
PRN_VALIDITY_DAYS=7
