    "/projects/{project_code}/config": {
      "get": {
        "summary": "Retrieve safe integration configuration",
        "operationId": "config",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
