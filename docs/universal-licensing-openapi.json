                    "name": "Kumar",
                    "email": "kumar@example.com",
                    "must_change_password": true,
                    "license": {
                      "license_id": 12,
                      "customer_id": 12,
                      "license_type": "TRIAL",
                      "state": "ACTIVE",
                      "starts_at": "2026-11-17T09:00:00Z",
                      "expires_at": "2026-12-17T09:00:00Z",
                      "serial_number": "912345678",
                      "user_id": "912345678"
                    },
                    "active_devices": 0
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Checks User ID + password (5 failures lock the account for 15 minutes). Does not create a device session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "user_id": "912345678",
                "password": "Temp-Pass-1"
              }
            }
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Change password (first login)",
