        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "verified": true,
                    "customer_id": 12,
                    "external_customer_id": "MOTHYS-1001",
