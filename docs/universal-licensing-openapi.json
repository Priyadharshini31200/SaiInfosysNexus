              }
            }
          }
        }
      }
    },
    "/activation/request": {
      "post": {
        "summary": "Request activation key",
        "operationId": "activation_request",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "sent_to": "ku***@example.com",
                    "expires_in_seconds": 900,
                    "email_status": "accepted"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Emails a one-time 9-digit key to the registered address (valid 15 minutes, 3 requests/hour). The key is never returned by the API.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "user_id": "912345678",
                "password": "Temp-Pass-1"
              }
            }
          }
        }
      }
    },
    "/activation/verify": {
      "post": {
        "summary": "Verify activation key / activate device",
        "operationId": "activation_verify",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "session_token": "nxt_example_session_token",
                    "session_id": 7,
                    "device_id": "PC-A1B2",
                    "license": {
                      "license_id": 12,
                      "customer_id": 12,
                      "license_type": "TRIAL",
                      "state": "ACTIVE",
                      "starts_at": "2026-11-17T09:00:00Z",
                      "expires_at": "2026-12-17T09:00:00Z",
                      "serial_number": "912345678",
                      "user_id": "912345678"
                    },
                    "authorization": "ACTIVE"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "409": {
            "description": "Transfer confirmation required",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "TRANSFER_CONFIRMATION_REQUIRED",
                    "title": "License Already Active on Another Device",
                    "message": "Your previous device session will be terminated and this device will become active. Do you want to continue?",
                    "actions": [
                      {
                        "id": "cancel",
                        "label": "Cancel"
                      },
                      {
                        "id": "confirm",
                        "label": "OK – Activate This Device"
                      }
                    ],
                    "transfer_token": "nxx_example",
                    "expires_in_seconds": 600,
                    "active_device_name": "Office PC"
                  }
                }
              }
            }
          }
        },
        "description": "Success returns a session. If another device holds the licence the answer is HTTP 409 TRANSFER_CONFIRMATION_REQUIRED with a transfer_token; call devices/transfer/confirm next.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "user_id": "912345678",
                "password": "Temp-Pass-1",
                "activation_key": "123456789",
                "device_id": "PC-A1B2",
                "device_name": "Office PC"
              }
            }
          }
        }
      }
    },
    "/devices/transfer/confirm": {
      "post": {
        "summary": "Confirm or cancel device transfer",
        "operationId": "transfer_confirm",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "status": "TRANSFERRED",
                    "transferred": true,
                    "session_token": "nxt_example_session_token",
                    "session_id": 8,
                    "device_id": "PC-C3D4",
                    "revoked_sessions": [
                      7
                    ],
                    "license": {
                      "license_id": 12,
                      "customer_id": 12,
                      "license_type": "TRIAL",
                      "state": "ACTIVE",
                      "starts_at": "2026-11-17T09:00:00Z",
                      "expires_at": "2026-12-17T09:00:00Z",
                      "serial_number": "912345678",
                      "user_id": "912345678"
                    },
                    "authorization": "ACTIVE"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "confirm=true revokes the old device's sessions immediately, activates this device and returns its session token. confirm=false changes nothing. Repeating a completed confirmation returns ALREADY_TRANSFERRED (the token is only ever returned once).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "user_id": "912345678",
                "transfer_token": "nxx_example",
                "confirm": true
              }
            }
          }
        }
      }
    },
    "/sessions/introspect": {
