    "/licenses/validate": {
      "post": {
        "summary": "Validate license",
        "operationId": "license_validate",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "license_id": 12,
                    "customer_id": 12,
                    "license_type": "TRIAL",
                    "state": "ACTIVE",
                    "starts_at": "2026-11-17T09:00:00Z",
                    "expires_at": "2026-12-17T09:00:00Z",
                    "serial_number": "912345678",
                    "user_id": "912345678",
                    "valid": true,
                    "active_devices": 1,
                    "device_limit": 1
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
