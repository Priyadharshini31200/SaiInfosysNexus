{
  "openapi": "3.0.3",
  "info": {
    "title": "Sai Infosys Nexus – Universal Licensing API",
    "version": "1.0.0",
    "description": "Server-to-server API. Authenticate with X-Client-Id and X-Client-Secret. Never call from a browser."
  },
  "servers": [
    {
      "url": "https://<NEXUS_PRODUCTION_HOST>/nexus/api/integrations/v1/",
      "description": "Production"
    },
    {
      "url": "http://127.0.0.1:8001/api/integrations/v1/",
      "description": "Local Nexus"
    }
  ],
  "paths": {
    "/customers/register": {
      "post": {
        "summary": "Register customer",
        "operationId": "register",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "status": "REGISTERED",
                    "customer_id": 12,
                    "license_id": 12,
                    "serial_number": "912345678",
                    "user_id": "912345678",
                    "license_type": "TRIAL",
                    "license_state": "ACTIVE",
                    "expires_at": "2026-12-17T09:00:00Z",
                    "welcome_email": "not_delivered|accepted|failed"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Creates the Nexus customer, a 9-digit serial (= User ID), a temporary password, the licence and queues the welcome email. Repeat calls with the same Idempotency-Key replay the first answer. Paid licence types stay PENDING_APPROVAL until approved in Nexus.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "external_customer_id": "MOTHYS-1001",
                "customer_name": "Kumar",
                "email": "kumar@example.com",
                "contact_number": "9876543210"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ]
      }
    },
    "/customers/update": {
      "post": {
        "summary": "Sync customer updates",
        "operationId": "update",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "status": "SYNCED",
                    "customer_id": 12,
                    "changed": [
                      "email"
                    ],
                    "license_state": "ACTIVE"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "event: CUSTOMER_UPDATED | EMAIL_CHANGED | CONTACT_UPDATED | CUSTOMER_INACTIVATED | CUSTOMER_REACTIVATED | LICENSE_STATUS_UPDATED. license_status may only be SUSPENDED or ACTIVE (lifting a suspension); a project can never grant a licence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "external_customer_id": "MOTHYS-1001",
                "event": "EMAIL_CHANGED",
                "email": "new@example.com"
              }
            }
          }
        }
      }
    },
    "/customers/import": {
      "post": {
        "summary": "One-time bulk import (max 200 per call)",
        "operationId": "import",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
          "Universal Licensing"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "imported": 1,
                    "failed": 0,
                    "results": [
                      {
                        "index": 0,
                        "external_customer_id": "MOTHYS-1001",
                        "ok": true,
                        "serial_number": "912345678"
                      }
                    ]
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Registers many existing customers with the same rules as customers/register. Each row succeeds or fails independently; failures appear in the Failed Sync Report.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "project_code": "MOTHYS",
                "send_welcome_email": true,
                "customers": [
                  {
                    "external_customer_id": "MOTHYS-1001",
                    "customer_name": "Kumar",
                    "email": "kumar@example.com",
                    "contact_number": "9876543210"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "summary": "Verify customer credentials",
        "operationId": "auth_verify",
        "security": [
          {
            "ClientId": [],
            "ClientSecret": []
          }
        ],
        "tags": [
