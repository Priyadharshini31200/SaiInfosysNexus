                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Identify the customer with user_id, serial_number or external_customer_id. state: ACTIVE | EXPIRED | PENDING_APPROVAL | SUSPENDED | INACTIVE.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
