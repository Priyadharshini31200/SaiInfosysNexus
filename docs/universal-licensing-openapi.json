              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "project_code": "MOTHYS",
                    "name": "Mothys Inventory Management",
                    "status": "SETUP_PENDING",
                    "serial_length": 9,
                    "activation_key_length": 9,
                    "device_limit": 1,
                    "transfer_policy": "SELF",
                    "trial_days": 30,
                    "default_license_type": "TRIAL",
                    "api_version": "1.0.0"
                  },
                  "request_id": "…"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "…"
                  },
                  "request_id": "…"
                }
              }
            }
          }
        },
        "description": "Never includes secrets.",
        "parameters": [
          {
            "name": "project_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Id"
      },
      "ClientSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Secret"
      }
    }
  },
  "x-error-codes": [
    {
